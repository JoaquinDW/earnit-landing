      </div>
    </div>
  </div>
</footer>

<script>
// The app's TickMeter: 46 hairline ticks, cobalt for the part you own.
var TICKS = 46;
var meter = document.getElementById('tickmeter');
for (var i = 0; i < TICKS; i++) meter.appendChild(document.createElement('i'));

var STEPS = {
  move: { progress: 0.33, value: '2,000 steps today' },
  earn: { progress: 0.66, value: '+10 min earned today' },
  use:  { progress: 1,    value: '10 min ready to spend' }
};

function select(step) {
  var s = STEPS[step];
  var ticks = meter.children;
  for (var i = 0; i < ticks.length; i++) {
    ticks[i].classList.toggle('on', i / TICKS < s.progress);
  }
  document.getElementById('meter-value').textContent = s.value;
  var buttons = document.querySelectorAll('#steps button');
  for (var j = 0; j < buttons.length; j++) {
    buttons[j].setAttribute('aria-pressed', String(buttons[j].dataset.step === step));
  }
}

document.getElementById('steps').addEventListener('click', function (event) {
  var button = event.target.closest('button[data-step]');
  if (button) select(button.dataset.step);
});

select('move');

// Some browsers refuse the initial autoplay until the video is ready; muted + playsinline
// makes it allowed, this just retries if the first attempt was rejected.
var hero = document.querySelector('.hero-video');
function play() { var p = hero.play(); if (p && p.catch) p.catch(function () {}); }
hero.addEventListener('canplay', play);
play();
</script>

</body>
</html>
