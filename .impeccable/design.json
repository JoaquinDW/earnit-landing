    {
      "name": "Navigation download",
      "kind": "button",
      "refersTo": "navigation-download",
      "description": "Compact pale acquisition action used in the sticky header.",
      "html": "<a class=\"ds-download\" href=\"https://apps.apple.com/app/id6804905841\">Get the app<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-download{display:inline-flex;align-items:center;gap:12px;background:var(--text,#ecf3ee);color:var(--ground,#070e0d);padding:10px 18px;border-radius:8px;text-decoration:none;font:600 14px/1.6 var(--sans,Figtree,sans-serif);min-height:44px;transition:background .2s}.ds-download:hover{background:#cdded2}.ds-download:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
      "name": "App Store badge",
      "kind": "button",
      "refersTo": "store-badge",
      "description": "Primary App Store acquisition badge, shared by the hero and closing section.",
      "html": "<a class=\"ds-store\" href=\"https://apps.apple.com/app/id6804905841\"><svg class=\"ds-apple\" viewBox=\"0 0 24 28\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.6 14.8c0-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.7-2.4-4.5-2.4-1.9-.2-3.7 1.1-4.7 1.1-1 0-2.5-1.1-4.1-1-2.1 0-4 1.2-5.1 3-2.2 3.8-.6 9.4 1.5 12.5 1 1.5 2.2 3.1 3.8 3 1.5-.1 2.1-1 4-1 1.9 0 2.4 1 4.1 1 1.7 0 2.7-1.5 3.7-3 .9-1.1 1.6-2.5 2-4-2.2-1-3.3-2.6-3.3-4.5ZM16.5 5.7c.9-1.1 1.6-2.7 1.4-4.2-1.4.1-3.1.9-4.1 2-.9 1-1.7 2.6-1.5 4.1 1.6.1 3.2-.8 4.2-1.9Z\"/></svg><span><small>Download on the</small><strong>App Store</strong></span></a>",
      "css": ".ds-store{display:inline-flex;align-items:center;gap:10px;border-radius:10px;border:1px solid #9aa69f;background:#000;color:#fff;text-decoration:none;padding:9px 17px 10px 15px;min-height:62px;font-family:var(--sans,Figtree,sans-serif);transition:background .2s,border-color .2s}.ds-store:hover{background:#15211b;border-color:var(--text,#ecf3ee)}.ds-apple{width:28px;height:32px}.ds-store small{display:block;font-size:11px;font-weight:400;line-height:1.2;letter-spacing:.01em}.ds-store strong{display:block;font-size:24px;font-weight:500;line-height:1.15;letter-spacing:-.02em}.ds-store:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
