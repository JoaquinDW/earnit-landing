  "components": [
    {
      "name": "Editorial navigation download",
      "kind": "button",
      "refersTo": "navigation-download",
      "description": "Shared pale acquisition action retained in site.css; homepage overrides it with the cobalt pill.",
      "html": "<a class=\"ds-download\" href=\"https://apps.apple.com/app/id6804905841\">Get the app<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-download{display:inline-flex;align-items:center;gap:12px;background:var(--text,#ecf3ee);color:var(--ground,#070e0d);padding:10px 18px;border-radius:8px;text-decoration:none;font:600 14px/1.6 var(--sans,Figtree,sans-serif);min-height:44px;transition:background .2s}.ds-download:hover{background:#cdded2}.ds-download:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
      "name": "App Store badge",
      "kind": "button",
      "refersTo": "store-badge",
      "description": "Primary App Store acquisition badge, shared by the hero and closing section.",
      "html": "<a class=\"ds-store\" href=\"https://apps.apple.com/app/id6804905841\"><svg class=\"ds-apple\" viewBox=\"0 0 24 28\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.6 14.8c0-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.7-2.4-4.5-2.4-1.9-.2-3.7 1.1-4.7 1.1-1 0-2.5-1.1-4.1-1-2.1 0-4 1.2-5.1 3-2.2 3.8-.6 9.4 1.5 12.5 1 1.5 2.2 3.1 3.8 3 1.5-.1 2.1-1 4-1 1.9 0 2.4 1 4.1 1 1.7 0 2.7-1.5 3.7-3 .9-1.1 1.6-2.5 2-4-2.2-1-3.3-2.6-3.3-4.5ZM16.5 5.7c.9-1.1 1.6-2.7 1.4-4.2-1.4.1-3.1.9-4.1 2-.9 1-1.7 2.6-1.5 4.1 1.6.1 3.2-.8 4.2-1.9Z\"/></svg><span><small>Download on the</small><strong>App Store</strong></span></a>",
      "css": ".ds-store{display:inline-flex;align-items:center;gap:10px;border-radius:10px;border:1px solid #9aa69f;background:#000;color:#fff;text-decoration:none;padding:9px 17px 10px 15px;min-height:62px;font-family:var(--sans,Figtree,sans-serif);transition:background .2s,border-color .2s}.ds-store:hover{background:#15211b;border-color:var(--text,#ecf3ee)}.ds-apple{width:28px;height:32px}.ds-store small{display:block;font-size:11px;font-weight:400;line-height:1.2;letter-spacing:.01em}.ds-store strong{display:block;font-size:24px;font-weight:500;line-height:1.15;letter-spacing:-.02em}.ds-store:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
      "name": "Language selection",
      "kind": "nav",
      "description": "Real reciprocal locale anchors, with current-page underline.",
      "html": "<nav class=\"ds-language\" aria-label=\"Language\"><a href=\"/\" aria-label=\"English\" aria-current=\"page\">EN</a><a href=\"/es/\" aria-label=\"Español\" lang=\"es\">ES</a></nav>",
      "css": ".ds-language{display:flex;gap:2px;font-family:var(--sans,Figtree,sans-serif)}.ds-language a{padding:10px 8px;min-height:44px;color:var(--muted,#96ada0);font-size:12px;font-weight:600;text-decoration:none}.ds-language a[aria-current=page]{color:var(--text,#ecf3ee);text-decoration:underline;text-decoration-color:var(--blue,#8caaff);text-underline-offset:6px}.ds-language a:hover{color:var(--text,#ecf3ee)}.ds-language a:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px}"
    },
    {
      "name": "Demo stage controls",
      "kind": "button",
      "refersTo": "demo-control",
      "description": "Lower homepage Walk / Earn / Unlock example controls; standalone preview illustrates their states.",
      "html": "<div class=\"ds-demo\" role=\"group\" aria-label=\"Try the steps-to-minutes example\"><button aria-pressed=\"false\">Walk</button><button aria-pressed=\"true\">Earn</button><button aria-pressed=\"false\">Unlock</button></div>",
      "css": ".ds-demo{display:inline-flex;align-items:center;gap:4px;color:#779080;font-family:var(--sans,Figtree,sans-serif)}.ds-demo button{border:0;background:transparent;padding:7px 17px;min-height:44px;font:400 14px/1.6 var(--sans,Figtree,sans-serif);border-radius:7px;color:var(--muted,#96ada0);transition:background .2s,color .2s;cursor:pointer}.ds-demo button[aria-pressed=true]{background:#263f2c;color:#e3f0de}.ds-demo button:hover{color:var(--text,#ecf3ee);background:var(--surface,#0c1814)}.ds-demo button:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
      "name": "Exchange example",
      "kind": "card",
      "refersTo": "exchange",
      "description": "Illustrative configurable exchange; homepage joins its bottom edge to the lower demo controls.",
      "html": "<div class=\"ds-exchange\"><div class=\"ds-value\"><span>1,000 steps</span><svg width=\"28\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg><span>5 minutes</span></div><p>An example exchange. Set your rate in the app.</p></div>",
      "css": ".ds-exchange{padding:22px 26px;background:var(--surface,#0c1814);color:var(--text,#ecf3ee);display:flex;justify-content:space-between;gap:24px;align-items:center;border-radius:12px;font:400 17px/1.6 var(--sans,Figtree,sans-serif)}.ds-value{display:flex;align-items:center;gap:18px;white-space:nowrap}.ds-value svg{color:var(--muted,#96ada0)}.ds-exchange p{margin:0;font-size:12px;color:var(--muted,#96ada0)}@media(max-width:760px){.ds-exchange{flex-direction:column;gap:12px;padding:22px 16px;text-align:center}.ds-value{font-size:15px;gap:12px}}"
    },
    {
      "name": "Native FAQ",
      "kind": "custom",
      "refersTo": "faq-summary",
      "description": "Native independent disclosure with plus/minus indicators and fine dividers.",
      "html": "<div class=\"ds-faq\"><details><summary>Which apps does it block?</summary><p>You pick the apps you want to manage using Apple’s Screen Time controls.</p></details></div>",
      "css": ".ds-faq{font-family:var(--sans,Figtree,sans-serif);color:var(--text,#ecf3ee)}.ds-faq details{border-bottom:1px solid var(--line,#293930)}.ds-faq details:first-child{border-top:1px solid var(--line,#293930)}.ds-faq summary{list-style:none;cursor:pointer;font-size:16px;font-weight:500;padding:22px 36px 22px 0;position:relative;line-height:1.5}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary:after{content:\"+\";position:absolute;right:4px;top:20px;color:var(--muted,#96ada0);font-size:22px;font-weight:400}.ds-faq details[open] summary:after{content:\"−\"}.ds-faq summary:hover{color:var(--blue,#8caaff)}.ds-faq details p{margin:0;color:var(--soft,#b9ccc2);font-size:15px;line-height:1.75;padding:0 32px 24px 0}.ds-faq summary:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
      "name": "Homepage navigation download",
      "kind": "button",
      "refersTo": "home-navigation-download",
      "description": "Cobalt pill acquisition action on the homepage only.",
