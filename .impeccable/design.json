      "css": ".ds-faq{font-family:var(--sans,Figtree,sans-serif);color:var(--text,#ecf3ee)}.ds-faq details{border-bottom:1px solid var(--line,#293930)}.ds-faq details:first-child{border-top:1px solid var(--line,#293930)}.ds-faq summary{list-style:none;cursor:pointer;font-size:16px;font-weight:500;padding:22px 36px 22px 0;position:relative;line-height:1.5}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary:after{content:\"+\";position:absolute;right:4px;top:20px;color:var(--muted,#96ada0);font-size:22px;font-weight:400}.ds-faq details[open] summary:after{content:\"\u2212\"}.ds-faq summary:hover{color:var(--blue,#8caaff)}.ds-faq details p{margin:0;color:var(--soft,#b9ccc2);font-size:15px;line-height:1.75;padding:0 32px 24px 0}.ds-faq summary:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    }
