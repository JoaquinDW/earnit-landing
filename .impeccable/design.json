      "html": "<div class=\"ds-language\" role=\"group\" aria-label=\"Language\"><button aria-label=\"English\" aria-pressed=\"true\">EN</button><button aria-label=\"Espa\u00f1ol\" aria-pressed=\"false\">ES</button></div>",
      "css": ".ds-language{display:flex;gap:2px}.ds-language button{background:transparent;border:0;padding:10px 8px;color:var(--muted,#96ada0);font:600 12px/1.6 var(--sans,Figtree,sans-serif);min-height:44px;cursor:pointer}.ds-language button[aria-pressed=true]{color:var(--text,#ecf3ee);text-decoration:underline;text-decoration-color:var(--blue,#8caaff);text-underline-offset:6px}.ds-language button:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
