      "html": "<div class=\"ds-demo\" role=\"group\" aria-label=\"Explore the app\"><button aria-pressed=\"false\">Walk</button><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg><button aria-pressed=\"true\">Earn</button><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg><button aria-pressed=\"false\">Unlock</button></div>",
      "css": ".ds-demo{display:inline-flex;align-items:center;gap:4px;color:#779080;font-family:var(--sans,Figtree,sans-serif)}.ds-demo button{border:0;background:transparent;padding:7px 12px;min-height:44px;font:400 13px/1.6 var(--sans,Figtree,sans-serif);border-radius:7px;color:var(--muted,#96ada0);transition:background .2s,color .2s;cursor:pointer}.ds-demo button[aria-pressed=true]{background:#1c2c24;color:var(--text,#ecf3ee)}.ds-demo button:hover{color:var(--text,#ecf3ee);background:var(--surface,#0c1814)}.ds-demo button:focus-visible{outline:2px solid var(--blue,#8caaff);outline-offset:5px;}"
    },
    {
